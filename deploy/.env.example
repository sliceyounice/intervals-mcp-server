# Copy to deploy/.env and fill in. Docker Compose reads this file automatically.

# Public hostname pointing at this server (DNS A/AAAA record). No scheme, no path.
# A free DuckDNS name (e.g. myname.duckdns.org) works too.
PUBLIC_HOST=mcp.example.com

# Key used to encrypt stored Intervals.icu API keys. Generate once and keep it safe:
#   openssl rand -base64 32 | tr '+/' '-_'
# Changing it later disconnects every user.
TOKEN_ENCRYPTION_KEY=
